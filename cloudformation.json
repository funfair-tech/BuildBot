{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "BuildBot",
  "Parameters": {
    "ApplicationName": {
      "Type": "String"
    },
    "ApplicationContainer": {
      "Type": "String"
    },
    "ApplicationVersion": {
      "Type": "String"
    },
    "SecurityGroupIDs": {
      "Type": "CommaDelimitedList",
      "Default": "sg-e3e65a9a,sg-0272027302777cb4d"
    },
    "SubnetIDs": {
      "Type": "CommaDelimitedList",
      "Default": "subnet-fabb50b3,subnet-d5ea03b2,subnet-c68aa09e"
    },
    "VpcID": {
      "Type": "String",
      "Default": "vpc-ad3bd9ca"
    },
    "LoadBalancerHostName": {
      "Type": "String"
    },
    "LoadBalancerPriority": {
      "Type": "Number"
    },
    "SecretsManagerArn": {
      "Type": "String",
      "Default": "arn:aws:secretsmanager:eu-west-1:117769150821:secret:BuildBot-ph1YIJ"
    }
  },
  "Mappings": {
    "Deployment": {
      "Cluster": {
        "Name": "DiscordBots"
      },
      "LoadBalancer": {
        "ListenerArn": "arn:aws:elasticloadbalancing:eu-west-1:117769150821:listener/app/testing/c383c5dd580a74f5/e82083ed48688c7a"
      },
      "Task": {
        "Cpu": "512",
        "Memory": "1024",
        "ContainerPort": "8080"
      },
      "Service": {
        "DesiredCount": "1",
        "MinimumHealthPercent": "100",
        "MaximumHealthPercent": "200"
      }
    }
  },
  "Metadata": {
    "Application": {
      "Ref": "ApplicationName"
    },
    "Version": {
      "Ref": "ApplicationVersion"
    }
  },
  "Resources": {
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "ContainerDefinitions": [
          {
            "Essential": true,
            "Image": { "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/funfair/${ApplicationContainer}:${ApplicationVersion}" },
            "Name": { "Ref": "ApplicationName" },
            "Environment": [
              {
                "Name": "CLOUDFORMATION__AWS__REGION",
                "Value": { "Ref": "AWS::Region" }
              }
            ],
            "Secrets": [
              {
                "Name": "DISCORD__WEBHOOKURL",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:DISCORD_WEBHOOK::" }
              },
              {
                "Name": "SERVEROCTOPUS__URL",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:OCTOPUS_URL::" }
              },
              {
                "Name": "SERVEROCTOPUS__APIKEY",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:OCTOPUS_API_KEY::" }
              },
              {
                "Name": "CLOUDFORMATION__TOPICARN",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:SNS_TOPIC_ARN::" }
              },
              {
                "Name": "CLOUDFORMATION__AWS__ACCESSKEYID",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:AWS_ACCESS_KEY_ID::" }
              },
              {
                "Name": "CLOUDFORMATION__AWS__SECRETKEY",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:AWS_SECRET_KEY::" }
              },
              {
                "Name": "GITHUB__WEBHOOKSECRET",
                "ValueFrom": { "Fn::Sub": "${SecretsManagerArn}:GITHUB_WEBHOOK_SECRET::" }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": { "Fn::Sub": "/ecs/${ApplicationName}/" },
                "awslogs-region": { "Ref": "AWS::Region" },
                "awslogs-stream-prefix": "ecs"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": { "Fn::FindInMap": ["Deployment", "Task", "ContainerPort"] },
                "HostPort": { "Fn::FindInMap": ["Deployment", "Task", "ContainerPort"] },
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "/usr/src/app/BuildBot",
                "--health-check",
                "http://127.0.0.1:8080/ping?source=docker"
              ],
              "Interval": "5",
              "Retries": "3",
              "StartPeriod": "5",
              "Timeout": "2"
            },
            "StartTimeout": "15",
            "StopTimeout": "15"
          }
        ],
        "Family": {
          "Ref": "ApplicationName"
        },
        "Cpu": {
          "Fn::FindInMap": ["Deployment", "Task", "Cpu"]
        },
        "Memory": {
          "Fn::FindInMap": ["Deployment", "Task", "Memory"]
        },
        "ExecutionRoleArn": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/ecsTaskExecutionRole" },
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        }
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/ecs/${ApplicationName}/" }
      }
    },
    "ECSService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Name": {
          "Ref": "ApplicationName"
        },
        "Cluster": {
          "Fn::FindInMap": ["Deployment", "Cluster", "Name"]
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DesiredCount": {
          "Fn::FindInMap": ["Deployment", "Service", "DesiredCount"]
        },
        "EnableECSManagedTags": false,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": { "Ref": "SecurityGroupIDs" },
            "Subnets": { "Ref": "SubnetIDs" }
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": {
            "Fn::FindInMap": ["Deployment", "Service", "MaximumHealthPercent"]
          },
          "MinimumHealthyPercent": {
            "Fn::FindInMap": ["Deployment", "Service", "MinimumHealthPercent"]
          },
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": { "Ref": "ApplicationName" },
            "ContainerPort": { "Fn::FindInMap": ["Deployment", "Task", "ContainerPort"] },
            "TargetGroupArn": { "Ref": "TargetGroup" }
          }
        ]
      },
      "DependsOn": ["ListenerRule"]
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Ref": "ApplicationName"
        },
        "HealthCheckPath": "/ping?source=target-group",
        "Port": { "Fn::FindInMap": ["Deployment", "Task", "ContainerPort"] },
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckEnabled": true,
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPort": { "Fn::FindInMap": ["Deployment", "Task", "ContainerPort"] },
        "HealthCheckTimeoutSeconds": 4,
        "HealthyThresholdCount": 5,
        "HealthCheckIntervalSeconds": 5,
        "VpcId": { "Ref": "VpcID" },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "5"
          }
        ]
      }
    },
    "ListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "Actions": [
          {
            "Type": "forward",
            "ForwardConfig": {
                "TargetGroups": [
                    {
                    "TargetGroupArn": { "Ref": "TargetGroup" },
                    "Weight": 1
                    }
                ],
                "TargetGroupStickinessConfig": {
                    "Enabled": false
                }
            }
          }
        ],
        "Conditions": [
              {
                "Field": "host-header",
                "Values": [{ "Ref": "LoadBalancerHostName" }]
              }
        ],
        "ListenerArn": { "Fn::FindInMap": ["Deployment", "LoadBalancer", "ListenerArn"] },
        "Priority": { "Ref": "LoadBalancerPriority" }
      }
    }
  }
}
